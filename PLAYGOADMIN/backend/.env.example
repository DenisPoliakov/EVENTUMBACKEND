DATABASE_URL="postgresql://playgoadmin:playgoadmin@localhost:5432/playgoadmin?schema=public"
# Tests that access data use only this separate database and skip when it is unset.
TEST_DATABASE_URL=
NODE_ENV=development
PORT=4000
ADMIN_USER=admin
ADMIN_PASSWORD=admin
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000
# Comma-separated. Empty allows all origins outside production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JSON_BODY_LIMIT=256kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
WEBHOOK_URL=
# YooKassa is optional. When omitted, order creation is persisted as PENDING
# and returns 503 with code PAYMENTS_NOT_CONFIGURED; no subscription is created.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/payments/return
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# App-wide Premium defaults (299 RUB for 30 days).
PREMIUM_PRICE_CENTS=29900
PREMIUM_DURATION_DAYS=30
PREMIUM_CURRENCY=RUB
# Optional FCM push delivery. Use one credential source; JSON must be single-line.
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# 0 disables the in-process expiry scheduler (recommended when an external job invokes it).
PUSH_EXPIRY_INTERVAL_MINUTES=0
PUSH_EXPIRY_WINDOW_DAYS=7
PUSH_EXPIRY_BATCH_SIZE=250
